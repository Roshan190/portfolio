# Absolute origin for canonical URLs, Open Graph, the sitemap, and JSON-LD.
# No path and no trailing slash. Example: https://example.com
# Unset builds fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Subpath when the site is hosted below the domain root, for example /portfolio
# on a GitHub Pages project site. Leave empty for a root host such as Vercel.
# Rebuild after changing this. Do not include a trailing slash.
NEXT_PUBLIC_BASE_PATH=
